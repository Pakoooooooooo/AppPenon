<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <!-- Barre haute : Paramètres globaux + bouton Créer groupe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnAddGroup"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="+ Groupe"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/sea"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnGlobalSettings"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="⚙️"
            android:textSize="16sp"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/appModeBtn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="🔧"
            android:visibility="gone"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="En attente..."
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/grey" />

    <!-- Boutons de contrôle scan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartScan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="▶️ Démarrer"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnStopScan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="⏹️ Arrêter"
            android:enabled="false"
            android:backgroundTint="@color/grey"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnClearData"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="🗑️ Effacer"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- Champ nom de fichier CSV (masqué par défaut) -->
    <EditText
        android:id="@+id/etFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Nom du fichier CSV"
        android:visibility="gone" />

    <!-- RecyclerView principal : pénons non configurés + groupes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPenonCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

</LinearLayout>
